{
  "name": "softlineby-cla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site officiel SOFTLINEBY.CLA — site statique (GitHub Pages) + réservations via Google Apps Script.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run media && next dev",
    "build": "npm run media && next build",
    "media": "tsx scripts/build-media.ts",
    "brand:build": "tsx scripts/build-brand.ts",
    "mock-api": "tsx scripts/mock-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
