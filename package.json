{
  "name": "softlineby-cla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site officiel SOFTLINEBY.CLA — portfolio fine line, réservation et administration.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "build:app": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "assets:prepare": "tsx scripts/prepare-assets.ts",
    "jobs:run": "tsx scripts/run-jobs.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@electric-sql/pglite": "0.5.10",
    "@vercel/blob": "2.8.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
