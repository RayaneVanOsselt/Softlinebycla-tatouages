# ════════════════════════════════════════════════════════════════════
#  SOFTLINEBY.CLA — variables d'environnement
#  Copiez ce fichier en « .env.local » pour le développement local,
#  et ajoutez les mêmes variables dans Vercel → Settings → Environment Variables.
#  ⚠️ Ne mettez JAMAIS de vraies valeurs dans ce fichier : il est publié avec le code.
# ════════════════════════════════════════════════════════════════════

# ─── Site ───
# Adresse publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Base de données (Neon via Vercel) ───
# Ajoutée automatiquement par Vercel quand vous connectez Neon (Storage → Neon).
# En local, laissez vide : une base embarquée est créée toute seule dans .data/
DATABASE_URL=

# ─── Sécurité ───
# Longue chaîne aléatoire (générez-la avec : openssl rand -base64 32)
AUTH_SECRET=
# Protège la tâche planifiée quotidienne (même méthode que ci-dessus)
CRON_SECRET=
# Adresse(s) autorisée(s) à se connecter à /admin (séparées par des virgules)
ADMIN_EMAILS=ton-adresse@gmail.com

# ─── E-mails : Gmail SMTP (100 % gratuit, ~500 e-mails/jour) ───
# SMTP_USER = votre adresse Gmail ; SMTP_PASSWORD = « mot de passe d'application » (16 lettres)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=SOFTLINEBY.CLA
# Valeurs initiales (modifiables ensuite dans l'admin → Paramètres)
CONTACT_EMAIL=
BOOKING_NOTIFICATION_EMAIL=

# ─── Google Agenda + Google Sheets (compte de service gratuit) ───
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Collez la clé privée sur une seule ligne, avec les \n (entre guillemets)
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Réservations
# (Facultatif) autres agendas à considérer comme « occupé », séparés par des virgules
GOOGLE_BUSY_CALENDAR_IDS=

# ─── Stockage des nouvelles photos/vidéos (Vercel Blob) ───
# Ajouté automatiquement par Vercel quand vous connectez Blob (Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# ─── Réservation (valeurs du cahier des charges) ───
TIMEZONE=Europe/Brussels
AVAILABLE_TIME_START=11:00
AVAILABLE_TIME_END=20:00
BOOKING_SLOT_MINUTES=60
# Toujours false : chaque demande est validée manuellement (true est ignoré)
AUTOMATIC_BOOKING_CONFIRMATION=false
DEFAULT_AVAILABILITY_CLOSED=true
PUBLIC_ADDRESS_ENABLED=false
PUBLIC_PHONE_ENABLED=false

# ─── Réseaux sociaux (valeurs initiales, modifiables dans l'admin) ───
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_PINTEREST=
